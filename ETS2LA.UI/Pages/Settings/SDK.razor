@page "/settings/sdk"
@layout Shared.Layouts.SettingsLayout
@using ETS2LA.Game
@using ETS2LA.State
@using ETS2LA.UI.Shared.Components

@code {
    [Parameter] public bool IsOnboarding { get; set; }
    [Parameter] public EventCallback OnOneSDKInstalled { get; set; }
    private List<Installation> Installations => GameHandler.Current.Installations;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        if (Installations.Any(i => i.IsSDKInstalled(i.Version))) await OnOneSDKInstalled.InvokeAsync();
    }

    private void SelectGameFolder() => AddGame(UserInterface.Current.Window.ShowOpenFolder(_("Select game folder")).FirstOrDefault());

    private void SelectGameExecutable()
    {
        string[] paths = UserInterface.Current.Window.ShowOpenFile(
            _("Select eurotrucks2.exe or amtrucks.exe"),
            filters: new[] { (_("Game executable"), new[] { ".exe" }), ("core.scs", new[] { ".scs" }) });
        AddGame(paths.FirstOrDefault());
    }

    private void AddGame(string? path)
    {
        if (string.IsNullOrEmpty(path)) return; // Cancel leaves the list unchanged.
        error = null;
        try
        {
            if (GameHandler.Current.AddManualInstallation(path) == null)
                error = _("Select the game folder containing core.scs, or eurotrucks2.exe / amtrucks.exe inside bin/win_x64.");
        }
        catch (Exception ex)
        {
            error = _("Could not add the game: {0}", ex.Message);
        }
    }

    private async Task InstallSdk(Installation installation)
    {
        error = null;
        if (ApplicationState.Current.IsGameRunning)
        {
            error = _("Close the game before installing or removing its SDKs.");
            return;
        }
        // Advance onboarding only after the SDK was actually copied successfully.
        if (installation.InstallSDK(installation.Version)) await OnOneSDKInstalled.InvokeAsync();
        else error = _("SDK installation failed. Check the game folder permissions and the logs, then try again.");
    }

    private void UninstallSdk(Installation installation)
    {
        error = null;
        if (ApplicationState.Current.IsGameRunning)
        {
            error = _("Close the game before installing or removing its SDKs.");
            return;
        }
        if (!installation.UninstallSDK(installation.Version))
            error = _("SDK removal failed. Check the game folder permissions and the logs, then try again.");
    }
}

<div class="flex flex-col min-w-0 p-5 gap-5">
    <div class="flex flex-col gap-2">
        <SectionTitle Title=@_("Game installations") />
        <p class="description">@_("Select a game folder or its executable if Steam does not list it. The location is remembered for SDK installation and map loading.")</p>
        <div class="flex flex-wrap gap-2">
            <button class="button" @onclick="SelectGameFolder">@_("Choose game folder")</button>
            <button class="button" @onclick="SelectGameExecutable">@_("Choose game executable")</button>
        </div>
        @if (error != null)
        {
            <p role="alert" class="text-danger break-words">@error</p>
        }
    </div>

    @if (Installations.Count == 0)
    {
        <p class="description">@_("No game installations found. Choose your Euro Truck Simulator 2 or American Truck Simulator folder above.")</p>
    }
    @foreach (var installation in Installations)
    {
        var installed = installation.IsSDKInstalled(installation.Version);
        <div @key="installation.Path" class="flex flex-col min-w-0 gap-3 p-4 rounded-sm bg-control-bg-dark border border-bg-darker">
            <div class="flex flex-wrap justify-between gap-2">
                <p class="font-semibold">@(installation.Type == GameType.EuroTruckSimulator2 ? "Euro Truck Simulator 2" : "American Truck Simulator") · @installation.Version</p>
                <p class="description">@(installation.IsManuallyAdded ? _("Added manually") : _("Found through Steam"))</p>
            </div>
            <p class="description break-all">@installation.Path</p>
            <p class="description break-all">@_("Executable: {0}", installation.ExecutablePath)</p>
            <p class="description break-all">@_("SDK folder: {0}", installation.SDKDirectory)</p>
            <p class="@(installed ? "text-success" : "text-text-l")">@(installed ? _("SDKs installed") : _("SDKs not installed"))</p>
            @if (!installed && !installation.HasBundledSDK(installation.Version))
            {
                <p class="text-warning">@_("No SDK is bundled for game version {0}. Update the game to a supported version before installing SDKs.", installation.Version)</p>
            }
            <button class="@(installed ? "button" : "button button-accent")"
                    disabled="@(!installed && !installation.HasBundledSDK(installation.Version))"
                    @onclick="async () => { if (installed) UninstallSdk(installation); else await InstallSdk(installation); }">
                @(installed ? _("Uninstall SDKs") : _("Install SDKs"))
            </button>
        </div>
    }
</div>
