@page "/settings/assists"
@layout Shared.Layouts.SettingsLayout

@using ETS2LA.UI.Shared.Components
@using ETS2LA.State
@using ETS2LA.Settings.Global

<div class="flex flex-col w-full p-5 px-8 gap-3">
    <SectionTitle Title=@_("Full Self-Driving") />
    <DrivingStatus />
    <p>@_("Fixed target: detected speed limit + 5 km/h.")</p>
    <p class="description">@_("Loaded automatically on every launch. Traffic, bends and traffic lights can reduce the speed below this target.")</p>

    <SectionTitle Class="mt-8" Title=@_("Fixed driving profile") />
    <div class="flex flex-wrap justify-between gap-2"><p>@_("Acceleration")</p><p class="text-text-l">@_("Fast")</p></div>
    <div class="flex flex-wrap justify-between gap-2"><p>@_("Following distance")</p><p class="text-text-l">@_("3 seconds")</p></div>
    <div class="flex flex-wrap justify-between gap-2"><p>@_("Collision avoidance")</p><p class="text-text-l">@_("Early")</p></div>
    <div class="flex flex-wrap justify-between gap-2"><p>@_("Stopping distance")</p><p class="text-text-l">@_("8 metres")</p></div>
    <div class="flex flex-wrap justify-between gap-2"><p>@_("Traffic lights and speed limits")</p><p class="text-text-l">@_("Enabled")</p></div>
    <p class="description">@_("Braking takes priority over acceleration. An unavailable route blocks acceleration and applies braking.")</p>
</div>
